# GitHub OAuth credentials for PR review support
# Copy this file to .env and fill in your values
# Get credentials from: https://github.com/settings/developers

GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Optional login for the OAuth authorize page.
# Set BOTH to require a username/password before the server issues a token.
# Leave unset to auto-approve all authorization requests (default).
# DIFFER_AUTH_USERNAME=admin
# DIFFER_AUTH_PASSWORD=change-me
